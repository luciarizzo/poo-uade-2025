@startuml
Class GestorReserva{
+void crearReserva(int numeroLibreta, int numeroApartamento);
+boolean validarDisponibilidad(int numeroApartamento);
+double calculoTotalMensual();
+ List<Reserva> obtenerReservasDeInquilino(int numeroLibreta);
+ Reserva buscarReservaPorApartamento(int numeroApartamento);
+ List<Apartamento> obtenerApartamentosDisponibles();
+ void agregarServicioExtraAReserva(int numeroApartamento, ServicioExtra servicio);
+ void mostrarResumenReservas();
}

Class Reserva{
- Apartamento apartamento;
- Inquilino inquilino;
- int mes;
- List<ServicioExtra> serviciosExtras;
+ double calcularCostoTotal();
+ void agregarServicioExtra(ServicioExtra servicio);
}

abstract class Apartamento{
- int numero;
- int capacidadMaxima;
- double precioBase;
+ abstract double calcularPrecioMensual();
}

class ApartamentoSimple{
+ double calcularPrecioMensual();
}

class ApartamentoDoble{
+ double calcularPrecioMensual();
}

class ApartamentoProletario{
+ double calcularPrecioMensual();
}

Class Inquilino{
- String nombre;
- int numeroLibreta;
}

Class ServicioExtra{
- String nombre;
- double precio;
}

Interface RepositorioApartamentos{
+ List<Apartamento> obtenerTodos();
}

Interface RepositorioReservas{
+ void agregarReserva(Reserva reserva);
+ List<Reserva> obtenerTodas();
+ Reserva buscarPorApartamento(int numeroApartamento);
+ List<Reserva> buscarPorInquilino(int numeroLibreta);
}

Reserva "1" *-- "1" Inquilino
Reserva "1" *-- "1" Apartamento
Reserva "1" *-- "0..*" ServicioExtra
GestorReserva "1" --> "1..*" Reserva
RepositorioApartamentos <|.. RepositorioApartamentosEnMemoria
RepositorioReservas <|.. RepositorioReservasEnMemoria
RepositorioApartamentosEnMemoria "1" --> "1..*" Apartamento
RepositorioReservasEnMemoria "1" --> "1..*" Reserva
Apartamento <|-- ApartamentoSimple
Apartamento <|-- ApartamentoDoble
Apartamento <|-- ApartamentoProletario
@enduml